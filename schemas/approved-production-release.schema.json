{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://multimedica.org/schemas/approved-production-release.schema.json",
  "title": "Approved Production Release Pointer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "version",
    "artifact",
    "sha256",
    "build_metadata",
    "approved_at"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "artifact": {
      "type": "string",
      "pattern": "^multimedica-production-[0-9]+\\.[0-9]+\\.[0-9]+\\.tgz$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "build_metadata": {
      "type": "string",
      "pattern": "^multimedica-production-[0-9]+\\.[0-9]+\\.[0-9]+\\.build\\.json$"
    },
    "approved_at": { "type": "string", "format": "date-time" }
  }
}
