{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://multimedica.org/schemas/secrets.schema.json",
  "title": "Device Secrets",
  "description": "Secret values stored in secrets.json (root:multimedica_edge 0640)",
  "type": "object",
  "required": ["schema_version", "qr_admin_token"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "qr_admin_token": {
      "type": "string",
      "minLength": 1,
      "description": "Fleet-wide QR authorization token. Never log this value."
    },
    "shared_secret": {
      "type": ["string", "null"],
      "description": "Bearer token for cloud endpoint. Never log this value."
    },
    "wifi_password": {
      "type": ["string", "null"],
      "description": "Wi-Fi password. Never log this value."
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
