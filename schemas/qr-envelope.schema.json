{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://multimedica.org/schemas/qr-envelope.schema.json",
  "title": "QR Envelope",
  "description": "Common wrapper for all MMCFG: provisioning QR payloads",
  "type": "object",
  "required": ["kind", "version", "payload"],
  "additionalProperties": true,
  "properties": {
    "kind": {
      "type": "string",
      "enum": ["wifi_config", "station_config", "cloud_config", "show_identity"]
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "payload": {
      "type": "object"
    },
    "auth": {
      "type": "object",
      "required": ["admin_token"],
      "properties": {
        "admin_token": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "show_identity"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "maxProperties": 0
          }
        }
      },
      "else": {
        "required": ["auth"]
      }
    }
  ]
}
