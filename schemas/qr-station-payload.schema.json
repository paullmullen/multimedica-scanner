{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://multimedica.org/schemas/qr-station-payload.schema.json",
  "title": "station_config QR Payload",
  "type": "object",
  "required": ["location_id", "room_id", "station_id", "device_id"],
  "additionalProperties": false,
  "properties": {
    "location_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "room_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "station_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "device_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    }
  }
}
