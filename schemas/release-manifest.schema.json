{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://multimedica.org/schemas/release-manifest.schema.json",
  "title": "Release Manifest",
  "description": "manifest.json embedded at the root of every release artifact tarball",
  "type": "object",
  "required": [
    "name",
    "version",
    "os_id",
    "arch",
    "capability_policy",
    "node_semver",
    "config_schema_version",
    "qr_schema_version",
    "min_bootstrap_version",
    "entry_point",
    "health_endpoint",
    "candidate_port",
    "built_at",
    "artifact_format_version",
    "content_sha256",
    "files"
  ],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string" },
    "version": { "type": "string" },
    "os_id": { "type": "string", "const": "debian-13-trixie-arm64" },
    "arch": { "type": "string", "enum": ["arm64"] },
    "capability_policy": { "type": "string", "const": "capability-qualified" },
    "node_semver": { "type": "string" },
    "config_schema_version": { "type": "integer", "minimum": 1 },
    "qr_schema_version": { "type": "integer", "minimum": 1 },
    "min_bootstrap_version": { "type": "string" },
    "entry_point": { "type": "string" },
    "health_endpoint": { "type": "string", "pattern": "^http://" },
    "candidate_port": { "type": "integer", "const": 3003 },
    "built_at": { "type": "string", "format": "date-time" },
    "artifact_format_version": { "type": "integer", "const": 1 },
    "content_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source_commit": { "type": ["string", "null"] },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "size"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
