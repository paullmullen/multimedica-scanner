{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://multimedica.org/schemas/provisioning-result.schema.json",
  "title": "Provisioning Result",
  "description": "Machine-readable output written by provision-scanner.ps1 to provisioning-result.json",
  "type": "object",
  "required": [
    "mode",
    "timestamp",
    "pi_host",
    "exit_code",
    "bootstrap_complete",
    "configuration_complete",
    "commissioning_complete",
    "errors",
    "warnings"
  ],
  "additionalProperties": false,
  "properties": {
    "mode": {
      "type": "string",
      "enum": [
        "Install",
        "Verify",
        "Commission",
        "Repair",
        "InstallRelease",
        "RollbackRelease",
        "ValidateProductionCandidate"
      ]
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "pi_host": { "type": "string" },
    "exit_code": { "type": "integer" },
    "bootstrap_complete": { "type": "boolean" },
    "configuration_complete": {
      "type": "boolean",
      "description": "True when all three provisioning QRs (wifi_config, station_config, cloud_config) have been accepted"
    },
    "controller_configuration_complete": {
      "type": ["boolean", "null"],
      "description": "Exact Boolean configuration_complete value parsed from controller status; null when status was unavailable or invalid"
    },
    "commissioning_complete": {
      "type": "boolean",
      "description": "True when configuration_complete AND release_installed AND production_ready are all true"
    },
    "release_installed": { "type": ["boolean", "null"] },
    "production_ready": { "type": ["boolean", "null"] },
    "platform_verified": { "type": ["boolean", "null"] },
    "services_healthy": { "type": ["boolean", "null"] },
    "reboot_verified": { "type": ["boolean", "null"] },
    "scanner_device_detected": {
      "type": ["boolean", "null"],
      "description": "True when scanner USB device appears in /proc/bus/input/devices"
    },
    "provisioning_qr_parsed": {
      "type": ["boolean", "null"],
      "description": "True when installer confirmed a QR was scanned and parsed. null means not tested in this run."
    },
    "network_connected": { "type": ["boolean", "null"] },
    "release_version": { "type": ["string", "null"] },
    "production_healthy": { "type": ["boolean", "null"] },
    "release_manager_installed": { "type": ["boolean", "null"] },
    "release_artifact_validator_installed": { "type": ["boolean", "null"] },
    "release_recovery_unit_installed": { "type": ["boolean", "null"] },
    "production_unit_installed": { "type": ["boolean", "null"] },
    "release_recovery_enabled": { "type": ["boolean", "null"] },
    "release_recovery_active": { "type": ["boolean", "null"] },
    "production_enabled": { "type": ["boolean", "null"] },
    "production_active": { "type": ["boolean", "null"] },
    "production_gate_present": { "type": ["boolean", "null"] },
    "current_release_present": { "type": ["boolean", "null"] },
    "install_operation_status": { "type": ["string", "null"] },
    "recovery_enabled_for_future_boots": { "type": ["boolean", "null"] },
    "candidate_health_passed": { "type": ["boolean", "null"] },
    "candidate_display_verified": { "type": ["boolean", "null"] },
    "operator_confirmed": { "type": ["boolean", "null"] },
    "promotion_completed": { "type": ["boolean", "null"] },
    "automatic_rollback": { "type": ["boolean", "null"] },
    "transaction_stage": { "type": ["string", "null"] },
    "errors": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
