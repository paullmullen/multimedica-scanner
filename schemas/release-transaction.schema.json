{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://multimedica.org/schemas/release-transaction.schema.json",
  "title": "Release Transaction Record",
  "description": "Written atomically before each activation stage; used for interruption recovery",
  "type": "object",
  "required": ["txn_id", "started_at", "target_version", "stage", "stages_completed"],
  "additionalProperties": false,
  "properties": {
    "txn_id": { "type": "string", "minLength": 1 },
    "started_at": { "type": "string", "format": "date-time" },
    "target_version": { "type": "string" },
    "stage": {
      "type": "string",
      "enum": [
        "resolving",
        "downloaded",
        "checksum_verified",
        "compatibility_verified",
        "extracted",
        "deps_installed",
        "candidate_started",
        "candidate_health_passed",
        "promotion_started",
        "readiness_passed",
        "health_passed",
        "candidate_stopped",
        "version_dir_renamed",
        "symlink_updated",
        "production_started",
        "production_health_passed",
        "post_promotion_verified",
        "known_good_promoted",
        "complete",
        "download_failed",
        "checksum_failed",
        "compatibility_failed",
        "extraction_failed",
        "deps_failed",
        "readiness_failed",
        "production_start_failed",
        "rolled_back",
        "first_activation_failed",
        "rollback_failed",
        "abandoned",
        "failed"
      ]
    },
    "stages_completed": {
      "type": "array",
      "items": { "type": "string" }
    },
    "artifact_path": { "type": ["string", "null"] },
    "staging_dir": { "type": ["string", "null"] },
    "candidate_pid": { "type": ["integer", "null"] },
    "candidate_manifest": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string" },
        "entry_point": { "type": "string" },
        "candidate_port": { "type": "integer" },
        "os_id": { "type": "string" },
        "arch": { "type": "string" },
        "capability_policy": { "type": "string" }
      }
    },
    "rollback_target": { "type": ["string", "null"] },
    "error": { "type": ["string", "null"] },
    "completed_at": { "type": ["string", "null"] }
  }
}
