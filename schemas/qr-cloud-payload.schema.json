{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://multimedica.org/schemas/qr-cloud-payload.schema.json",
  "title": "cloud_config QR Payload",
  "type": "object",
  "required": ["endpoint_url", "shared_secret"],
  "additionalProperties": false,
  "properties": {
    "endpoint_url": {
      "type": "string",
      "pattern": "^https://"
    },
    "shared_secret": {
      "type": "string",
      "minLength": 1
    }
  }
}
